# Google Tag Manager
# Get your GTM ID from https://tagmanager.google.com → Container ID (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Site URL (used for metadata / OG tags)
SITE_URL=https://www.hooklore.com

# Amazon Associates — affiliate links on pattern "Materials".
# Until the tag is set, materials render as plain text (no links). Get your tag
# from https://affiliate-program.amazon.com after approval (format: name-20).
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=
# Optional: override the Amazon storefront (default www.amazon.com)
NEXT_PUBLIC_AMAZON_DOMAIN=
